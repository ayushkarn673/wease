# Copy to backend/.env and fill in. backend/.env is gitignored — never commit real values.
# Format: Java properties (KEY=value).

# Optional locally (defaults to MySQL on localhost). In production, the cloud database's JDBC URL, e.g.
# DB_URL=jdbc:mysql://HOST:PORT/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me
# Base64-encoded key of at least 64 bytes, e.g. generated with:  openssl rand -base64 64
JWT_SECRET=change-me

# Optional: base URL of the frontend, used in email links
# FRONTEND_URL=http://localhost:5173

# Optional: real email sending (password reset / verification). Without these, emails are written to the log.
# spring.mail.host=smtp.example.com
# spring.mail.port=587
# spring.mail.username=
# spring.mail.password=
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# MAIL_FROM=Wease <no-reply@yourdomain.com>

# Production only: the website address(es) allowed to call the API (comma-separated, wildcards allowed)
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
